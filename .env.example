# === v1.0 — in use today ===

# Overrides the default shared password for the login gate.
SITE_PASSWORD=

# Enables the Macro tab's live FRED data. Free, instant signup:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# === Phase 1 (Foundations) ===

# Neon Postgres connection string. Get one free at https://neon.tech
# (or provision via Vercel's Storage tab, which is Neon under the hood).
DATABASE_URL=

# Upstash Redis, for rate-limiting SEC EDGAR calls and general caching.
# Free tier: https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Phase 2 (Company Intelligence) ===

# SEC EDGAR needs no key — data.sec.gov is open. It DOES require a
# descriptive User-Agent header per SEC's fair-use policy (see 05-DATA-SOURCES.md).
EDGAR_USER_AGENT="AI Wealth OS contact@example.com"

# Twelve Data — free tier covers India (NSE/BSE) equity fundamentals with
# ~4hr delay. https://twelvedata.com
TWELVE_DATA_API_KEY=

# === Phase 3 (Suitability / News sentiment) ===

# Only needed if the FinBERT service calls the HuggingFace Inference API
# instead of running the model locally/self-hosted.
HUGGINGFACE_API_TOKEN=

# === If/when adding real auth (Auth.js) — not needed while single-user ===

# Resend, for magic-link emails. https://resend.com
RESEND_API_KEY=
AUTH_SECRET=

# === Multi-model delegation (optional, see chat discussion) ===

# Only if you want Claude (via this project) to call Gemini's API directly
# for a second opinion / delegated subtask. Not required for using Gemini
# Code Assist inside VSCode, which authenticates itself.
GEMINI_API_KEY=

# Only needed if scripting GitHub issue creation / PR review from the
# command line rather than doing it in VSCode/GitHub's UI.
GITHUB_TOKEN=
